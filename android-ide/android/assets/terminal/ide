#!/system/bin/sh
# Android IDE first-party application-control CLI.
# This package is bundled in the private Termux runtime; operations run only on user command.
set -f

IDE_TOOLS_VERSION=2.0.1
IDE_PACKAGE="${IDE_PACKAGE:-com.termux}"
IDE_RECEIPT_DIRECTORY="${IDE_RECEIPT_DIRECTORY:-${PREFIX:-/data/data/com.termux/files/usr}/../browser-navigation-receipts}"
IDE_TOOLS_RECEIPT_DIRECTORY="${IDE_TOOLS_RECEIPT_DIRECTORY:-${PREFIX:-/data/data/com.termux/files/usr}/../ide-tools-receipts}"
IDE_TOOLS_AUTH_TOKEN_CACHE="${IDE_TOOLS_AUTH_TOKEN:-}"
unset IDE_TOOLS_AUTH_TOKEN
JSON=false

usage() {
    cat <<'USAGE'
Usage: ide DOMAIN COMMAND [ARGUMENTS|OPTIONS] [INPUT...]
       ide [--json] help [DOMAIN [COMMAND]]

Android IDE application-control and workspace tools. Commands perform real
operations; package installation/removal is never automatic. Every domain has
help, status, and test commands; use `ide help DOMAIN` for domain-specific help.

Top-level:
  ide help [DOMAIN [COMMAND]]
  ide init [--manager pkg|apt] [--skip-storage] [--skip-packages]
  ide status [--json]
  ide test TARGET [--json]

Domains:
  app       status|test|doctor|logs
  terminal  status|test|sessions|storage
  storage   status|test|setup|rebuild
  browser   status|test|open|reload|back|forward|stop|tabs|downloads
  editor    status|test|refresh|tabs|open|save|format
  preview   status|test|start|stop
  projects  status|test|list|open|close|create|import|rename|duplicate|relocate|unregister|delete|export
  files     status|test|list|read|write|create|rename|copy|move|delete
  search    status|test|files|content
  tools     status|test|install|remove

Package installation defaults: npm, global. `tools install web-preview`
installs the Android IDE-managed preview package outside the terminal prefix;
use `tools install package PKG` to manage user terminal npm packages.
`preview start` only starts the already-installed IDE-managed Live Server
package in the active project at localhost:7468.
`init` installs base terminal utilities only when explicitly invoked.

Use `ide help DOMAIN` or `ide DOMAIN help` for exact arguments and safety
requirements. `--json` emits JSON Lines for status and test results.
Exit codes: 0 success, 1 operation failed, 2 invalid usage, 3 unavailable,
4 permission/setup or explicit confirmation required.
USAGE
}

domain_help() {
    domain=${1:-}; command_name=${2:-}
    if [ -n "$command_name" ]; then
        case "$domain:$command_name" in
            browser:open) printf 'Usage: ide browser open [--new-tab|--current-tab] -u URL\nOpens a validated HTTP(S) URL in Android IDE Browser.\n';;
