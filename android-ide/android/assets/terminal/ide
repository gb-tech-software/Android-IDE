projects_command() {
    [ "$#" -ge 1 ] || usage_error 'projects requires a command; use ide help projects'
    sub=$1; shift
    case "$sub" in
        help|-h|--help) domain_help projects "${1:-}"; return $? ;;
        status|test|list)
            [ "$#" -eq 0 ] || usage_error "projects $sub accepts no arguments"
            case "$sub" in status) app_request projects.status ;; test) app_request projects.test ;; list) app_request projects.list ;; esac ;;
        open)
            [ "$#" -ge 1 ] || usage_error 'usage: ide projects open PROJECT_ID [--dirty save|discard|cancel]'
            id=$1; shift; dirty=cancel
            while [ "$#" -gt 0 ]; do
                case "$1" in --dirty) [ "$#" -ge 2 ] || usage_error '--dirty requires save, discard, or cancel'; dirty=$2; shift 2;; -h|--help) domain_help projects open; return;; *) usage_error "unknown projects open option '$1'";; esac
            done
            case "$dirty" in save|discard|cancel) :;; *) usage_error '--dirty must be save, discard, or cancel';; esac
            app_request_args projects.open "$id" 45 "$dirty" ;;
        close)
            dirty=''
            if [ "$#" -gt 0 ]; then [ "$#" -eq 2 ] && [ "$1" = --dirty ] || usage_error 'usage: ide projects close [--dirty save|discard]'; dirty=$2; fi
            case "$dirty" in ''|save|discard) :;; *) usage_error '--dirty must be save or discard';; esac
            app_request_args projects.close '' 45 "$dirty" ;;
        create)
            parent=''; name=''; description=''
            while [ "$#" -gt 0 ]; do
                case "$1" in --parent) [ "$#" -ge 2 ] || usage_error '--parent requires a storage URI/path'; parent=$2; shift 2;; --name) [ "$#" -ge 2 ] || usage_error '--name requires a project name'; name=$2; shift 2;; --description) [ "$#" -ge 2 ] || usage_error '--description requires text'; description=$2; shift 2;; -h|--help) domain_help projects create; return;; *) usage_error "unknown projects create option '$1'";; esac
            done
            [ -n "$parent" ] && [ -n "$name" ] || usage_error 'usage: ide projects create --parent STORAGE_URI --name NAME [--description TEXT]'
            app_request_args projects.create '' 60 "$parent" "$name" "$description" ;;
        import-folder)
            [ "$#" -ge 1 ] || usage_error 'usage: ide projects import-folder PROJECT_URI [--name NAME] [--description TEXT]'
            source=$1; shift; name=''; description=''
            while [ "$#" -gt 0 ]; do case "$1" in --name) [ "$#" -ge 2 ] || usage_error '--name requires a value'; name=$2; shift 2;; --description) [ "$#" -ge 2 ] || usage_error '--description requires a value'; description=$2; shift 2;; -h|--help) domain_help projects import-folder; return;; *) usage_error "unknown import-folder option '$1'";; esac; done
            app_request_args projects.import-folder '' 60 "$source" "$name" "$description" ;;
        import-zip)
            [ "$#" -ge 3 ] || usage_error 'usage: ide projects import-zip ARCHIVE_URI PARENT_URI NAME [DESCRIPTION]'
            archive=$1; parent=$2; name=$3; description=${4:-}; [ "$#" -le 4 ] || usage_error 'import-zip accepts at most a description'
            app_request_args projects.import-zip '' 90 "$archive" "$parent" "$name" "$description" ;;
        rename)
            [ "$#" -ge 2 ] || usage_error 'usage: ide projects rename PROJECT_ID NAME [--dirty save|discard]'
            id=$1; name=$2; shift 2; dirty=''
            if [ "$#" -gt 0 ]; then [ "$#" -eq 2 ] && [ "$1" = --dirty ] || usage_error 'invalid rename options'; dirty=$2; fi
            case "$dirty" in ''|save|discard) :;; *) usage_error '--dirty must be save or discard';; esac
            app_request_args projects.rename "$id" 60 "$name" "$dirty" ;;
        duplicate|relocate)
            [ "$#" -ge 5 ] || usage_error "usage: ide projects $sub PROJECT_ID --parent STORAGE_URI --name NAME [--description TEXT] [--dirty save|discard]"
            id=$1; shift; [ "$1" = --parent ] && [ "$#" -ge 4 ] || usage_error '--parent STORAGE_URI is required'; parent=$2; shift 2
            [ "$1" = --name ] && [ "$#" -ge 2 ] || usage_error '--name NAME is required'; name=$2; shift 2
            description=''; dirty=''
            while [ "$#" -gt 0 ]; do case "$1" in --description) [ "$#" -ge 2 ] || usage_error '--description requires text'; description=$2; shift 2;; --dirty) [ "$#" -ge 2 ] || usage_error '--dirty requires save or discard'; dirty=$2; shift 2;; -h|--help) domain_help projects "$sub"; return;; *) usage_error "unknown projects $sub option '$1'";; esac; done
            case "$dirty" in ''|save|discard) :;; *) usage_error '--dirty must be save or discard';; esac
            if [ "$sub" = duplicate ]; then app_request_args projects.duplicate "$id" 120 "$parent" "$name" "$description" "$dirty"
            else app_request_args projects.relocate "$id" 120 "$parent" "$name" "$dirty"; fi ;;
        unregister|delete)
            [ "$#" -ge 2 ] || usage_error "usage: ide projects $sub PROJECT_ID --confirm PROJECT_ID [--dirty save|discard]"
            id=$1; shift; [ "$1" = --confirm ] && [ "$#" -ge 2 ] || usage_error "projects $sub requires --confirm PROJECT_ID"; confirm=$2; shift 2
            [ "$confirm" = "$id" ] || usage_error 'the --confirm value must exactly match PROJECT_ID'
            dirty=''
            if [ "$#" -gt 0 ]; then [ "$#" -eq 2 ] && [ "$1" = --dirty ] || usage_error 'invalid dirty-buffer option'; dirty=$2; fi
            case "$dirty" in ''|save|discard) :;; *) usage_error '--dirty must be save or discard';; esac
            if [ "$sub" = delete ]; then app_request_args projects.delete "$id" 90 "$confirm" "$dirty"
            else app_request_args projects.unregister "$id" 60 "$confirm" "$dirty"; fi ;;
        export)
            [ "$#" -eq 3 ] && [ "$2" = --to ] || usage_error 'usage: ide projects export PROJECT_ID --to DESTINATION_URI'
            app_request_args projects.export "$1" 90 "$3" ;;
        *) usage_error "unknown projects command '$sub'" ;;
    esac
}

