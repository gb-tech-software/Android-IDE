[ "$#" -gt 0 ] || { usage; exit 0; }
[ "$1" = --json ] && { JSON=true; shift; }
[ "$#" -gt 0 ] || usage_error '--json requires a command'
case "$1" in
    -h|--help) usage; exit 0 ;;
    help) shift; if [ "$#" -eq 0 ]; then usage; exit 0; fi; domain_help "$1" "${2:-}"; exit $? ;;
    -v|--version) printf 'android-ide-tools %s\n' "$IDE_TOOLS_VERSION"; exit 0 ;;
esac

# Keep the original convenient URL form as an alias.
case "$1" in http://*|https://*|localhost:*|127.0.0.1:*|www.*) set -- browser open --new-tab -u "$1" ;; esac

domain=$1; shift
if [ "$JSON" = true ]; then
    case "$domain" in
        status|test|browser|editor|preview|projects|files|search) ;;
        storage) case "${1:-}" in status|test) :;; *) usage_error 'JSON mode supports only ide storage status|test';; esac ;;
        terminal) case "${1:-}" in status|test|doctor|sessions) :;; *) usage_error 'JSON mode supports terminal status/test/sessions';; esac ;;
        tools)
            case "${1:-}:$#:${2:-}" in status:1:|test:1:|status:2:lsp) :;; *) usage_error 'JSON mode supports only ide tools status, ide tools test, or ide tools status lsp';; esac ;;
        app) [ "${1:-}" != logs ] || usage_error 'app logs does not support JSON mode' ;;
        *) usage_error "JSON mode is not supported for '$domain'" ;;
    esac
fi
case "$domain" in
    init)
        case "${1:-}" in
            help|-h|--help) domain_help init ;;
            status) shift; [ "$#" -eq 0 ] || usage_error 'init status accepts no arguments'; status_command ;;
            test) shift; [ "$#" -eq 0 ] || usage_error 'init test accepts no arguments'; test_command all ;;
            *) init_command "$@" ;;
        esac ;;
    status)
        case "${1:-}" in help|-h|--help) [ "$#" -eq 1 ] || usage_error 'status help accepts no arguments'; domain_help status;;
            --json) [ "$#" -eq 1 ] || usage_error 'status accepts only --json'; JSON=true; status_command;;
            '') status_command;;
            *) usage_error 'usage: ide status [--json]' ;;
        esac ;;
    test)
        [ "$#" -ge 1 ] || usage_error 'test requires a target: all, app, browser, editor, preview, projects, storage, terminal, or tools'
        target=$1; shift
        [ "$#" -le 1 ] || usage_error 'test accepts only an optional --json'
        [ "${1:-}" = --json ] && JSON=true
        test_command "$target" ;;
    storage) storage_command "$@" ;;
    browser) browser_command "$@" ;;
    editor) editor_command "$@" ;;
    projects|project) projects_command "$@" ;;
    files) files_command "$@" ;;
    search) search_command "$@" ;;
    preview) preview_command "$@" ;;
    tools) tools_command "$@" ;;
    terminal) terminal_command "$@" ;;
    app) app_command "$@" ;;
    open) browser_open --new-tab -u "$@" ;;
    *) usage_error "unknown domain '$domain'" ;;
esac
