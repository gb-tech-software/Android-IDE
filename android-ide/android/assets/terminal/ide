tools_command() {
    [ "$#" -ge 1 ] || usage_error 'tools requires a command; use ide help tools'
    action=$1; shift
    case "$action" in
        help|-h|--help) domain_help tools "${1:-}"; return $? ;;
        status|test) if [ "$#" -eq 0 ]; then app_request "tools.$action"; return $?; fi ;;
    esac
    [ "$#" -ge 1 ] || usage_error 'usage: ide tools install|status|remove lsp|web-preview|package PACKAGE [options]'
    tool=$1; shift
    package_name=''
    if [ "$tool" = package ]; then
        case "${1:-}" in -h|--help) domain_help tools package; return $? ;; esac
        [ "$#" -ge 1 ] || usage_error "tools $action package requires a package name"
        package_name=$1; shift
        case "$package_name" in ''|-*|*[!A-Za-z0-9@._/-]*) usage_error "invalid npm package name '$package_name'";; esac
        case "$package_name" in *..*|*/../*|*/..) usage_error "invalid npm package name '$package_name'";; esac
    fi
    manager=npm; scope=global
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --manager) [ "$#" -ge 2 ] || usage_error '--manager requires npm or pnpm'; manager=$2; shift 2 ;;
            --global) scope=global; shift ;;
            --local) scope=local; shift ;;
            -h|--help) printf 'Usage: ide tools %s %s [--manager npm|pnpm] [--global|--local]\n' "$action" "$tool"; return 0 ;;
            *) usage_error "unknown tools option '$1'" ;;
        esac
    done
    case "$manager" in npm|pnpm) :;; *) usage_error "unsupported package manager '$manager' (use npm or pnpm)";; esac
    case "$scope" in global|local) :;; *) usage_error "unsupported install scope '$scope'";; esac
    case "$action:$tool" in
        status:lsp|install:lsp|remove:lsp)
            [ "$manager" = npm ] && [ "$scope" = global ] || usage_error 'LSP tools use the app-managed pinned package set; manager/scope options apply only to terminal package operations'
            case "$action" in status) app_request tools.lsp.status ;; install) app_request tools.lsp.install '' 200 ;; remove) app_request tools.lsp.remove ;; esac ;;
        status:web-preview|status:servers)
            [ "$manager" = npm ] && [ "$scope" = global ] || usage_error 'web-preview is app-managed; manager/scope options apply only to terminal package operations'
            app_request tools.preview.status ;;
        install:web-preview|install:servers)
            [ "$manager" = npm ] && [ "$scope" = global ] || usage_error 'web-preview is app-managed; manager/scope options apply only to terminal package operations'
            app_request tools.preview.install '' 200 ;;
        remove:web-preview|remove:servers)
            [ "$manager" = npm ] && [ "$scope" = global ] || usage_error 'web-preview is app-managed; manager/scope options apply only to terminal package operations'
            app_request tools.preview.remove ;;
        status:package)
            case "$manager:$scope" in
                npm:global) command -v npm >/dev/null 2>&1 || return 3; npm list --global "$package_name" --depth=0 ;;
                npm:local) command -v npm >/dev/null 2>&1 || return 3; npm list "$package_name" --depth=0 ;;
                pnpm:global) command -v pnpm >/dev/null 2>&1 || return 3; PNPM_HOME="${PNPM_HOME:-${PREFIX:-}/bin}" pnpm list --global "$package_name" ;;
                pnpm:local) command -v pnpm >/dev/null 2>&1 || return 3; pnpm list "$package_name" ;;
            esac ;;
        install:package)
            case "$manager:$scope" in
                npm:global) command -v npm >/dev/null 2>&1 || return 3; npm install --global "$package_name" ;;
                npm:local) command -v npm >/dev/null 2>&1 || return 3; npm install --save-dev "$package_name" ;;
                pnpm:global) command -v pnpm >/dev/null 2>&1 || return 3; PNPM_HOME="${PNPM_HOME:-${PREFIX:-}/bin}" pnpm add --global "$package_name" ;;
                pnpm:local) command -v pnpm >/dev/null 2>&1 || return 3; pnpm add --save-dev "$package_name" ;;
            esac ;;
        remove:package)
            case "$manager:$scope" in
                npm:global) command -v npm >/dev/null 2>&1 || return 3; npm uninstall --global "$package_name" ;;
                npm:local) command -v npm >/dev/null 2>&1 || return 3; npm uninstall --save-dev "$package_name" ;;
                pnpm:global) command -v pnpm >/dev/null 2>&1 || return 3; PNPM_HOME="${PNPM_HOME:-${PREFIX:-}/bin}" pnpm remove --global "$package_name" ;;
                pnpm:local) command -v pnpm >/dev/null 2>&1 || return 3; pnpm remove --save-dev "$package_name" ;;
            esac ;;
        install:base)
            [ "$scope" = global ] || usage_error 'base package-manager setup installs pnpm globally; use `ide tools install package PACKAGE --local` for project-local tools'
            case "$manager" in npm) command -v npm >/dev/null 2>&1 || return 3; npm install --global pnpm ;;
                pnpm) command -v pnpm >/dev/null 2>&1 || return 3; PNPM_HOME="${PNPM_HOME:-${PREFIX:-}/bin}" pnpm add --global pnpm ;;
                *) usage_error "unsupported package manager '$manager'" ;; esac ;;
        status:base)
            [ "$manager" = npm ] && [ "$scope" = global ] || usage_error 'base status does not use package-manager/scope options'
            for tool in git node npm pnpm zip unzip; do path=$(command -v "$tool" 2>/dev/null) || path=missing; printf '%-10s %s\n' "$tool" "$path"; done ;;
        *) usage_error "unsupported tools operation '$action $tool'" ;;
    esac
}

files_command() {
    [ "$#" -ge 1 ] || usage_error 'files requires a command; use ide help files'
    sub=$1; shift
    case "$sub" in
        help|-h|--help) domain_help files "${1:-}"; return $? ;;
        status|test) [ "$#" -eq 0 ] || usage_error "files $sub accepts no arguments"; app_request "files.$sub" ;;
        list) [ "$#" -le 1 ] || usage_error 'usage: ide files list [PROJECT_RELATIVE_PATH]'; app_request_args files.list '' 45 "${1:-}" ;;
        read) [ "$#" -eq 1 ] || usage_error 'usage: ide files read PROJECT_RELATIVE_PATH'; app_request_args files.read '' 45 "$1" ;;
        write)
            [ "$#" -eq 2 ] && [ "$2" = --stdin ] || usage_error 'usage: ide files write PROJECT_RELATIVE_PATH --stdin'
            umask 077
            token=$(request_id)
            input_file="${TMPDIR:-/tmp}/android-ide-write-$token.bin"
            encoded_file="${TMPDIR:-/tmp}/android-ide-write-$token.base64"
            if ! cat >"$input_file"; then rm -f "$input_file" "$encoded_file"; return 1; fi
            input_size=$(wc -c <"$input_file" | tr -d '[:space:]')
            case "$input_size" in ''|*[!0-9]*) rm -f "$input_file"; printf 'ide: could not measure stdin size\n' >&2; return 1;; esac
            if [ "$input_size" -gt 36000 ]; then rm -f "$input_file" "$encoded_file"; printf 'ide: stdin exceeds the 36 KB write limit\n' >&2; return 4; fi
            if ! base64 <"$input_file" | tr -d '\n' >"$encoded_file"; then rm -f "$input_file" "$encoded_file"; return 1; fi
            encoded=$(cat "$encoded_file") || { rm -f "$input_file" "$encoded_file"; return 1; }
            rm -f "$input_file" "$encoded_file"
            expected_encoded_size=$(( (input_size + 2) / 3 * 4 ))
            [ "${#encoded}" -eq "$expected_encoded_size" ] || { printf 'ide: stdin could not be encoded completely\n' >&2; return 1; }
            [ "${#encoded}" -le 48000 ] || { printf 'ide: encoded stdin exceeds the app receipt limit\n' >&2; return 4; }
            app_request_args files.write '' 60 "$1" "$encoded" ;;
        create|mkdir) [ "$#" -eq 1 ] || usage_error "usage: ide files $sub PROJECT_RELATIVE_PATH"; app_request_args "files.$sub" '' 45 "$1" ;;
        rename) [ "$#" -eq 2 ] || usage_error 'usage: ide files rename PROJECT_RELATIVE_PATH NEW_NAME'; app_request_args files.rename '' 45 "$1" "$2" ;;
        copy|move) [ "$#" -eq 2 ] || usage_error "usage: ide files $sub SOURCE_PATH DESTINATION_DIRECTORY"; app_request_args "files.$sub" '' 60 "$1" "$2" ;;
        delete)
            [ "$#" -eq 3 ] && [ "$2" = --confirm ] || usage_error 'usage: ide files delete PROJECT_RELATIVE_PATH --confirm PROJECT_RELATIVE_PATH'
            [ "$1" = "$3" ] || usage_error 'delete confirmation must exactly match the path'
            app_request_args files.delete '' 60 "$1" "$3" ;;
        *) usage_error "unknown files command '$sub'" ;;
    esac
}

