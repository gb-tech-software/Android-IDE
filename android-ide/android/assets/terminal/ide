    case "$domain" in
        status) printf 'Usage: ide status [--json]\nReports installed terminal tools plus authenticated app, terminal, and preview state.\n';;
        test) printf 'Usage: ide test TARGET [--json]\nTARGET: all|app|browser|editor|files|preview|projects|search|storage|terminal|tools.\n';;
        init) printf 'Usage: ide init [--manager pkg|apt] [--skip-storage] [--skip-packages]\n       ide init status|test|help\nBootstrap installs only the listed base packages when explicitly requested; test runs app/runtime health checks.\n';;
