            init:status) printf 'Usage: ide init status\nReports terminal package paths plus app/runtime status without installing anything.\n';;
            init:test) printf 'Usage: ide init test\nRuns all app/runtime integration checks without installing packages.\n';;
            test:all) printf 'Usage: ide test all [--json]\nRuns app, browser, editor, file/search, preview, project, storage, terminal, and tools health checks.\n';;
            browser:tabs) printf 'Usage: ide browser tabs list|select TAB_ID|close TAB_ID\n';;
            browser:downloads) printf 'Usage: ide browser downloads list|open [DOWNLOAD_ID]|pause|resume|cancel|retry|delete DOWNLOAD_ID\n';;
            editor:tabs) printf 'Usage: ide editor tabs list|select TAB_ID|close TAB_ID [--dirty save|discard]\n';;
            editor:open) printf 'Usage: ide editor open DOCUMENT_URI\nOpens a document URI already inside the active project.\n';;
            editor:format) printf 'Usage: ide editor format [TAB_ID]\nDispatches Monaco formatDocument only when an installed language server advertises formatting support.\n';;
            terminal:sessions) printf 'Usage: ide terminal sessions list|close SESSION_ID\n';;
            storage:setup|storage:rebuild) printf 'Usage: ide storage %s\nInvokes Termux shared-storage setup and may request Android permission.\n' "$command_name";;
            tools:package) printf 'Usage: ide tools install|status|remove package PACKAGE [--manager npm|pnpm] [--global|--local]\nDefaults to npm global; local operations use the current terminal directory.\n';;
