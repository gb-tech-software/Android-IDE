        terminal) printf 'Usage: ide terminal status|test|sessions list|close SESSION_ID|storage\nstatus reports runtime and session state; test starts and closes a temporary PTY.\n';;
        storage) printf 'Usage: ide storage status|test|setup|rebuild\nsetup/rebuild invoke Termux storage setup and the Android permission flow; status/test inspect ~/storage links.\n';;
        browser) printf 'Usage: ide browser status|test|open|reload|back|forward|stop|tabs [list|select|close]|downloads [list|open|cancel|pause|resume|retry|delete]\n';;
        editor) printf 'Usage: ide editor status|test|refresh|tabs [list|select|close]|open DOCUMENT_URI|save [TAB_ID]|save-all|format [TAB_ID]\n';;
        preview) printf 'Usage: ide preview status|test|start|stop\ntest requires the IDE-managed Live Server to be running and checks its HTTP response.\n';;
        projects) printf 'Usage: ide projects status|test|list|open ID [--dirty save|discard|cancel]|close [--dirty save|discard]|create|import-folder|import-zip|rename|duplicate|relocate|unregister|delete|export\nLocations are provider URIs/paths. Destructive removals require exact --confirm PROJECT_ID.\n';;
        files) printf 'Usage: ide files status|test|list [PATH]|read PATH|write PATH --stdin|create PATH|mkdir PATH|rename PATH NEW_NAME|copy PATH DEST_DIR|move PATH DEST_DIR|delete PATH --confirm PATH\nPaths are relative to the active project root; writes require confirmed local access, and destructive changes reject open editor tabs.\n';;
        search) printf 'Usage: ide search status|test|files QUERY|content QUERY [--regex] [--case-sensitive] [--whole-word]\nSearch is scoped to the active project.\n';;
        tools) printf 'Usage: ide tools status|test|install|remove lsp|web-preview|package PACKAGE [--manager npm|pnpm] [--global|--local]\n       ide tools status base\nInstall/remove are explicit; LSP and web-preview are app-managed; generic packages default to npm global.\n';;
        *) usage >&2; return 2;;
    esac
}

usage_error() { printf 'ide: error: %s\n' "$*" >&2; usage >&2; exit 2; }
fail() { printf 'ide: %s\n' "$*" >&2; return 1; }

json_escape() {
    printf '%s' "$1" | awk '
        {
            if (NR > 1) printf "\\n"
            gsub(/\\/, "\\\\")
            gsub(/"/, "\\\"")
            for (n = 1; n < 32; n++) {
                if (n == 9 || n == 10 || n == 13) continue
                gsub(sprintf("%c", n), sprintf("\\u%04x", n))
            }
            gsub(/\t/, "\\t")
            gsub(/\r/, "\\r")
            printf "%s", $0
        }
    '
}

json_array() {
    result='['; separator=''
    for value do
        result="$result$separator\"$(json_escape "$value")\""
        separator=,
    done
    printf '%s]' "$result"
}

request_id() {
    id=$(cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -d '-')
    [ -n "$id" ] || id="ide-$$-$(date +%s)"
    printf '%s' "$id"
}

app_request() {
    command_name=$1
    target=${2:-}
    wait_limit=${3:-45}
    payload=${4:-[]}
    case "$wait_limit" in ''|*[!0-9]*) usage_error 'invalid internal command timeout' ;; esac
    request=$(request_id)
    result_file="$IDE_TOOLS_RECEIPT_DIRECTORY/$request.result"
    output_file="${TMPDIR:-/tmp}/android-ide-tools-$request.log"
    [ -n "$IDE_TOOLS_AUTH_TOKEN_CACHE" ] || { printf 'ide: app command bridge token is unavailable; initialize the terminal runtime first\n' >&2; return 4; }
    mkdir -p "$IDE_TOOLS_RECEIPT_DIRECTORY" || { printf 'ide: cannot access the app command receipt directory\n' >&2; return 1; }
    rm -f "$result_file"
    if [ -n "$target" ]; then
        case "$target" in *[!A-Za-z0-9._-]*) printf 'ide: invalid command target\n' >&2; return 2 ;; esac
        am start -W -n "$IDE_PACKAGE/dev.android.ide.MainActivity" \
            -a 'dev.android.ide.action.IDE_TOOLS_COMMAND' \
            --es 'dev.android.ide.extra.IDE_TOOLS_COMMAND' "$command_name" \
            --es 'dev.android.ide.extra.IDE_TOOLS_REQUEST_ID' "$request" \
            --es 'dev.android.ide.extra.IDE_TOOLS_AUTH_TOKEN' "$IDE_TOOLS_AUTH_TOKEN_CACHE" \
            --es 'dev.android.ide.extra.IDE_TOOLS_TARGET' "$target" \
            --es 'dev.android.ide.extra.IDE_TOOLS_PAYLOAD' "$payload" >"$output_file" 2>&1
    else
        am start -W -n "$IDE_PACKAGE/dev.android.ide.MainActivity" \
            -a 'dev.android.ide.action.IDE_TOOLS_COMMAND' \
            --es 'dev.android.ide.extra.IDE_TOOLS_COMMAND' "$command_name" \
            --es 'dev.android.ide.extra.IDE_TOOLS_REQUEST_ID' "$request" \
            --es 'dev.android.ide.extra.IDE_TOOLS_AUTH_TOKEN' "$IDE_TOOLS_AUTH_TOKEN_CACHE" \
            --es 'dev.android.ide.extra.IDE_TOOLS_PAYLOAD' "$payload" >"$output_file" 2>&1
    fi
    result=$?
    if [ "$result" -ne 0 ]; then
        [ ! -s "$output_file" ] || cat "$output_file" >&2
        rm -f "$output_file"
        return "$result"
    fi
    attempt=0
    while [ "$attempt" -lt "$wait_limit" ]; do
        if [ -f "$result_file" ]; then
            exec 3<"$result_file"
            IFS= read -r result_code <&3
            IFS= read -r result_message <&3
            IFS= read -r result_data <&3 || result_data=''
            exec 3<&-
            rm -f "$result_file" "$output_file"
            if [ "$JSON" = true ]; then
                if [ "$command_name" = files.read ]; then
                    printf '{"command":"%s","status":%s,"message":"%s","dataBase64":"%s"}\n' \
                        "$(json_escape "$command_name")" "${result_code:-1}" "$(json_escape "${result_message:-no result message}")" "$result_data"
                else
                    printf '{"command":"%s","status":%s,"message":"%s"}\n' \
                        "$(json_escape "$command_name")" "${result_code:-1}" "$(json_escape "${result_message:-no result message}")"
                fi
            elif [ "$command_name" = files.read ] && [ "${result_code:-1}" -eq 0 ]; then
                decoded_file="${TMPDIR:-/tmp}/android-ide-tools-$request.data"
                if printf '%s' "$result_data" | base64 -d >"$decoded_file"; then cat "$decoded_file"; else rm -f "$decoded_file"; return 1; fi
                rm -f "$decoded_file"
            else
                printf '%s\n' "${result_message:-no result message}"
            fi
            case "$result_code" in 0|1|2|3|4) return "$result_code" ;; *) return 1 ;; esac
        fi
        sleep 1
        attempt=$((attempt + 1))
    done
    rm -f "$output_file"
    printf 'ide: Android IDE did not complete %s (request %s) within %s seconds\n' "$command_name" "$request" "$wait_limit" >&2
    return 1
}

app_request_args() {
    command_name=$1; target=${2:-}; wait_limit=${3:-45}
    [ "$#" -ge 3 ] || usage_error 'internal command argument list is malformed'
    shift 3
    payload=$(json_array "$@") || return 1
    app_request "$command_name" "$target" "$wait_limit" "$payload"
}

normalize_url() {
    URL=$1
    case "$URL" in
        localhost:*|127.0.0.1:*) URL="http://$URL" ;;
        *://*) : ;;
        *.*|www.*) URL="https://$URL" ;;
    esac
    case "$URL" in
        http://*|https://*) : ;;
        *) return 1 ;;
    esac
    case "$URL" in
        http://*.*|https://*.*|http://localhost*|https://localhost*|http://127.0.0.1*|https://127.0.0.1*) return 0 ;;
        *) return 1 ;;
    esac
}

browser_open() {
    mode=new-tab
    if [ "$1" = --current-tab ]; then mode=current-tab; shift
    elif [ "$1" = --new-tab ]; then shift
    fi
    [ "$1" = -u ] || usage_error 'browser open requires -u URL'
    shift
    [ "$#" -eq 1 ] || usage_error 'browser open requires exactly one URL after -u'
    normalize_url "$1" || usage_error "invalid URL '$1'; use http://, https://, localhost:PORT, or 127.0.0.1:PORT"
    url=$URL
    id=$(request_id)
    receipt="$IDE_RECEIPT_DIRECTORY/$id.status"
    output_file="${TMPDIR:-/tmp}/android-ide-open-url-$id.log"
    mkdir -p "$IDE_RECEIPT_DIRECTORY" || return 1
    rm -f "$receipt"
    new_tab=true; [ "$mode" = new-tab ] || new_tab=false
    am start -W -n "$IDE_PACKAGE/dev.android.ide.MainActivity" \
        -a 'dev.android.ide.action.OPEN_URL_REQUEST' \
        --es 'dev.android.ide.extra.OPEN_URL' "$url" \
        --es 'dev.android.ide.extra.OPEN_URL_REQUEST_ID' "$id" \
        --ez 'dev.android.ide.extra.OPEN_URL_NEW_TAB' "$new_tab" >"$output_file" 2>&1
    result=$?
    if [ "$result" -ne 0 ]; then [ ! -s "$output_file" ] || cat "$output_file" >&2; rm -f "$output_file" "$receipt"; return "$result"; fi
    attempt=0
    while [ "$attempt" -lt 15 ]; do
        if [ -f "$receipt" ]; then
            status=$(cat "$receipt" 2>/dev/null)
            rm -f "$output_file"
            case "$status" in
                dispatched) [ "$JSON" = true ] && printf '{"command":"browser.open","status":"dispatched","url":"%s","mode":"%s"}\n' "$(json_escape "$url")" "$mode" || printf 'Opened %s in Android IDE Browser (%s).\n' "$url" "$mode"; return 0 ;;
                rejected) printf 'ide: Android IDE rejected the URL request\n' >&2; return 1 ;;
            esac
        fi
        sleep 1; attempt=$((attempt + 1))
    done
    rm -f "$output_file"
    printf 'ide: browser navigation was not confirmed (receipt=%s)\n' "$(cat "$receipt" 2>/dev/null)" >&2
    return 1
}

run_package_manager() {
    manager=$1; shift
    case "$manager" in
        pkg) command -v pkg >/dev/null 2>&1 || { printf 'ide: pkg is unavailable\n' >&2; return 3; }; pkg "$@" ;;
        apt) command -v apt >/dev/null 2>&1 || { printf 'ide: apt is unavailable\n' >&2; return 3; }; apt "$@" ;;
        *) usage_error "unsupported system package manager '$manager' (use pkg or apt)" ;;
    esac
}

storage_setup() {
    helper=$(command -v termux-setup-storage 2>/dev/null)
    [ -n "$helper" ] || { printf 'ide: termux-setup-storage is unavailable; initialize the terminal runtime first\n' >&2; return 3; }
    "$helper"
}

init_command() {
    manager=pkg; do_storage=true; do_packages=true
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --manager) [ "$#" -ge 2 ] || usage_error '--manager requires pkg or apt'; manager=$2; shift 2 ;;
            --skip-storage) do_storage=false; shift ;;
            --skip-packages) do_packages=false; shift ;;
            -h|--help) printf 'Usage: ide init [--manager pkg|apt] [--skip-storage] [--skip-packages]\n'; return 0 ;;
            *) usage_error "unknown init option '$1'" ;;
        esac
    done
    case "$manager" in pkg|apt) :;; *) usage_error "unsupported system package manager '$manager' (use pkg or apt)";; esac
    if [ "$do_storage" = false ] && [ "$do_packages" = false ]; then
        usage_error 'init has no requested actions; use ide init status or ide init test for checks'
    fi
    if [ "$do_storage" = true ]; then
        printf 'Setting up Android shared-storage links (Android may ask for permission)…\n'
        storage_setup || { printf 'ide: storage setup did not complete\n' >&2; return 4; }
    fi
    if [ "$do_packages" = true ]; then
        printf 'Updating the %s package index…\n' "$manager"
        if [ "$manager" = pkg ]; then run_package_manager pkg update -y || return 1
        else run_package_manager apt update || return 1; fi
        printf 'Installing base packages: git, nodejs-lts, zip, unzip…\n'
        if [ "$manager" = pkg ]; then run_package_manager pkg install -y git nodejs-lts zip unzip || return 1
        else run_package_manager apt install -y git nodejs-lts zip unzip || return 1; fi
        if command -v npm >/dev/null 2>&1; then
            printf 'Installing pnpm globally with npm…\n'
            npm install --global pnpm || return 1
        else
            printf 'ide: Node.js package installed but npm is unavailable\n' >&2
            return 3
        fi
    fi
    printf 'Android IDE terminal bootstrap completed. Optional tools such as Live Server and LSP packages are installed separately with `ide tools install`.\n'
}

status_command() {
    if [ "$JSON" = true ]; then
        printf '{"command":"status","tools":{"git":"%s","node":"%s","npm":"%s","pnpm":"%s","live_server":"%s","zip":"%s","unzip":"%s"}}\n' \
            "$(json_escape "$(command -v git 2>/dev/null || printf missing)")" "$(json_escape "$(command -v node 2>/dev/null || printf missing)")" \
            "$(json_escape "$(command -v npm 2>/dev/null || printf missing)")" "$(json_escape "$(command -v pnpm 2>/dev/null || printf missing)")" \
            "app-managed" "$(json_escape "$(command -v zip 2>/dev/null || printf missing)")" \
            "$(json_escape "$(command -v unzip 2>/dev/null || printf missing)")"
        app_request tools.status
        app_request app.status
    else
        printf 'Android IDE terminal tools\n'
        for tool in git node npm pnpm zip unzip; do
            path=$(command -v "$tool" 2>/dev/null) || path=missing
            printf '  %-12s %s\n' "$tool" "$path"
        done
        printf '  %-12s %s\n' live-server app-managed
        app_request tools.status || return $?
        app_request app.status || return $?
    fi
}

test_command() {
    target=$1
    case "$target" in
        help|-h|--help) domain_help test; return $? ;;
        terminal) app_request terminal.test ;;
        storage) app_request storage.test ;;
        tools) app_request tools.test ;;
        projects|project) app_request projects.test ;;
        files) app_request files.test ;;
        search) app_request search.test ;;
        preview) app_request preview.test ;;
        browser) app_request browser.test ;;
        editor) app_request editor.test ;;
        app) app_request app.test ;;
        all)
            failures=0
            for test_name in app terminal storage browser editor preview tools projects files search; do
                test_command "$test_name" || failures=$((failures+1))
            done
            if [ "$JSON" = true ]; then
                printf '{"command":"test.all","status":%s,"message":"%s integration check(s) failed"}\n' \
                    "$([ "$failures" -eq 0 ] && printf 0 || printf 1)" "$failures"
            fi
            [ "$failures" -eq 0 ] || { [ "$JSON" = true ] || printf 'ide: %s integration check(s) failed\n' "$failures" >&2; return 1; } ;;
        *) usage_error "unknown test '$target' (use all, app, browser, editor, files, preview, projects, search, storage, terminal, or tools)" ;;
    esac
}

