{
  "manifest_version": 2,
  "name": "Android IDE Developer Tools",
  "version": "1.0.2",
  "description": "Built-in page developer tools for Android IDE browser tabs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "android-ide-devtools@android-ide"
    }
  },
  "permissions": ["<all_urls>", "nativeMessaging", "geckoViewAddons"],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": ["eruda.js", "page-bridge.js"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["devtools.js"],
    "run_at": "document_idle"
  }]
}
